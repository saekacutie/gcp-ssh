#!/bin/bash
# ============================================
# UNIVERSAL SNI REVERSE PROXY SERVER
# GCP Deployment | Multi-Port | Multi-Host
# Listens on 80, 443, 8080, 22, 3128
# Forwards any host to its real destination
# ============================================
clear

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'
BG_RED='\033[41m'
BG_GREEN='\033[42m'
BG_BLUE='\033[44m'

# ============================================
# CONFIGURATION
# ============================================
SERVICE_NAME="universal-sni-proxy"
SSH_USER="proxyadmin"
SSH_PASS="ProxySecure@2025"
ROOT_PASS="RootSecure@2025"
ZONE="us-central1-a"
MACHINE_TYPE="e2-medium"

# Ports to listen on
PORTS="80 443 8080 22 3128 8443 8888"

while [[ $# -gt 0 ]]; do
    case $1 in
        --name) SERVICE_NAME="$2"; shift 2 ;;
        --user) SSH_USER="$2"; shift 2 ;;
        --pass) SSH_PASS="$2"; shift 2 ;;
        --root) ROOT_PASS="$2"; shift 2 ;;
        --zone) ZONE="$2"; shift 2 ;;
        --machine) MACHINE_TYPE="$2"; shift 2 ;;
        *) shift ;;
    esac
done

success() { echo -e "  ${GREEN}[OK]${RESET} $1"; }
info()    { echo -e "  ${CYAN}[*]${RESET} $1"; }
warn()    { echo -e "  ${YELLOW}[!]${RESET} $1"; }

# ============================================
# BANNER
# ============================================
echo -e "${CYAN}${BOLD}"
echo "  +--------------------------------------------------------+"
echo "  |                                                        |"
echo "  |   ${WHITE}UNIVERSAL SNI REVERSE PROXY SERVER${CYAN}                  |"
echo "  |   ${DIM}Multi-Port | Multi-Host | Full Forwarding${CYAN}           |"
echo "  |                                                        |"
echo "  |   ${WHITE}Listen:${RESET} 80, 443, 8080, 22, 3128, 8443, 8888         ${CYAN}${BOLD}|"
echo "  |   ${WHITE}Forward:${RESET} Any host -> Real destination              ${CYAN}${BOLD}|"
echo "  +--------------------------------------------------------+"
echo -e "${RESET}"

echo ""
echo -e "${YELLOW}${BOLD}  CONFIGURATION${RESET}"
echo -e "  ${CYAN}Service:${RESET}     ${WHITE}$SERVICE_NAME${RESET}"
echo -e "  ${CYAN}SSH User:${RESET}     ${WHITE}$SSH_USER${RESET}"
echo -e "  ${CYAN}SSH Pass:${RESET}     ${WHITE}$SSH_PASS${RESET}"
echo -e "  ${CYAN}Ports:${RESET}        ${WHITE}$PORTS${RESET}"
echo ""

# ============================================
# CHECK PREREQUISITES
# ============================================
if ! command -v gcloud &> /dev/null; then
    echo -e "${BG_RED}${WHITE} [FATAL] gcloud not found. Run in Cloud Shell. ${RESET}"
    exit 1
fi

ACCOUNT=$(gcloud auth list --filter=status:ACTIVE --format="value(account)" 2>/dev/null || echo "")
if [ -z "$ACCOUNT" ]; then
    echo -e "${BG_RED}${WHITE} [FATAL] Not authenticated. ${RESET}"
    exit 1
fi

PROJECT_ID=$(gcloud config get-value project 2>/dev/null || echo "")
if [ -z "$PROJECT_ID" ]; then
    PROJECT_ID=$(gcloud projects list --format='value(projectId)' --limit=1 2>/dev/null || echo "")
    if [ -z "$PROJECT_ID" ]; then
        echo -e "${BG_RED}${WHITE} [FATAL] No project found. ${RESET}"
        exit 1
    fi
    gcloud config set project "$PROJECT_ID" 2>/dev/null
fi
success "Project: $PROJECT_ID"
success "Account: $ACCOUNT"

# ============================================
# ENABLE APIS
# ============================================
gcloud services enable compute.googleapis.com --quiet 2>/dev/null
success "Compute API enabled"

# ============================================
# CREATE FIREWALL RULES
# ============================================
FIREWALL_RULES=""
for port in $PORTS; do
    RULE="allow-${SERVICE_NAME}-port-${port}"
    FIREWALL_RULES="$FIREWALL_RULES $RULE"
    gcloud compute firewall-rules delete "$RULE" --quiet 2>/dev/null || true
    gcloud compute firewall-rules create "$RULE" \
        --allow tcp:${port} \
        --direction=INGRESS \
        --priority=1000 \
        --quiet 2>/dev/null
done
success "Firewall rules created for ports: $PORTS"

# ============================================
# BUILD STARTUP SCRIPT
# ============================================
TMP_DIR=$(mktemp -d)

cat > "$TMP_DIR/startup-script.sh" << 'STARTUPEOF'
#!/bin/bash
set -e

SSH_USER=$(curl -sf "http://metadata.google.internal/computeMetadata/v1/instance/attributes/SSH_USER" -H "Metadata-Flavor: Google" || echo "proxyadmin")
SSH_PASS=$(curl -sf "http://metadata.google.internal/computeMetadata/v1/instance/attributes/SSH_PASS" -H "Metadata-Flavor: Google")
ROOT_PASS=$(curl -sf "http://metadata.google.internal/computeMetadata/v1/instance/attributes/ROOT_PASS" -H "Metadata-Flavor: Google")
SERVICE_NAME=$(curl -sf "http://metadata.google.internal/computeMetadata/v1/instance/attributes/SERVICE_NAME" -H "Metadata-Flavor: Google")

LOG="/var/log/proxy-setup.log"
echo "[$(date)] Starting Universal SNI Proxy setup" > "$LOG"

# Update system
apt-get update -y >> "$LOG" 2>&1
apt-get upgrade -y -qq >> "$LOG" 2>&1

# Install required packages
apt-get install -y nginx squid apache2-utils stunnel4 openssl curl wget git python3 python3-pip netcat-openbsd >> "$LOG" 2>&1

# ============================================
# CONFIGURE NGINX AS REVERSE SNI PROXY
# ============================================
cat > /etc/nginx/nginx.conf << 'NGINXEOF'
user www-data;
worker_processes auto;
pid /run/nginx.pid;

events {
    worker_connections 4096;
    multi_accept on;
}

stream {
    # SNI Proxy - Forwards any TLS connection to its real destination
    map $ssl_preread_server_name $backend {
        default $ssl_preread_server_name:443;
    }

    # HTTPS Proxy (port 443)
    server {
        listen 443;
        proxy_pass $backend;
        ssl_preread on;
        proxy_connect_timeout 10s;
        proxy_timeout 30s;
    }

    # HTTP to HTTPS redirect (port 80)
    server {
        listen 80;
        proxy_pass 127.0.0.1:8443;
    }

    # Alternate ports
    server {
        listen 8080;
        proxy_pass $backend;
        ssl_preread on;
    }

    server {
        listen 8443;
        proxy_pass $backend;
        ssl_preread on;
    }

    server {
        listen 8888;
        proxy_pass $backend;
        ssl_preread on;
    }
}

http {
    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    # HTTP handler for port 80 direct requests
    server {
        listen 127.0.0.1:8443;
        
        location / {
            return 200 '{"status":"ok","service":"SNI Proxy Ready","host":"$host"}';
            add_header Content-Type application/json;
        }
    }
}
NGINXEOF

systemctl enable nginx
systemctl restart nginx

# ============================================
# CONFIGURE SQUID FORWARD PROXY (Port 3128)
# ============================================
cat > /etc/squid/squid.conf << 'SQUIDEOF'
http_port 0.0.0.0:3128

# Allow all
acl all src 0.0.0.0/0
http_access allow all

# Hide client info
forwarded_for delete
via off
request_header_access X-Forwarded-For deny all
request_header_access Via deny all
request_header_access Cache-Control deny all

# Performance
cache_mem 256 MB
maximum_object_size_in_memory 512 KB
cache_dir ufs /var/spool/squid 1000 16 256

# Logging
access_log /var/log/squid/access.log
cache_log /var/log/squid/cache.log
SQUIDEOF

systemctl enable squid
systemctl restart squid

# ============================================
# CONFIGURE STUNNEL (TLS Wrapper)
# ============================================
mkdir -p /etc/stunnel

openssl req -new -newkey rsa:2048 -days 3650 -nodes -x509 \
    -subj "/C=US/ST=CA/L=City/O=Proxy/CN=localhost" \
    -keyout /etc/stunnel/stunnel.key \
    -out /etc/stunnel/stunnel.crt 2>> "$LOG"

cat /etc/stunnel/stunnel.crt /etc/stunnel/stunnel.key > /etc/stunnel/stunnel.pem
chmod 600 /etc/stunnel/stunnel.pem

# Stunnel forwards clear text to TLS
cat > /etc/stunnel/stunnel.conf << STUNEOF
[https-forward]
accept = 0.0.0.0:443
connect = 127.0.0.1:8443
cert = /etc/stunnel/stunnel.pem
TIMEOUTclose = 0
STUNEOF

# ============================================
# INSTALL DOCKER AND SSH CONTAINER
# ============================================
if ! command -v docker &> /dev/null; then
    curl -fsSL https://get.docker.com -o /tmp/get-docker.sh 2>> "$LOG"
    sh /tmp/get-docker.sh >> "$LOG" 2>&1
fi
systemctl enable docker 2>/dev/null || true
systemctl start docker 2>/dev/null || true

docker rm -f ssh-proxy 2>/dev/null || true

# SSH Docker container (port 22)
cat > /root/Dockerfile.ssh << 'DOCKEREOF'
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server sudo curl wget net-tools socat python3 && \
    mkdir -p /var/run/sshd && apt-get clean
RUN echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config && \
    echo 'PasswordAuthentication yes' >> /etc/ssh/sshd_config && \
    echo 'AllowTcpForwarding yes' >> /etc/ssh/sshd_config && \
    echo 'GatewayPorts yes' >> /etc/ssh/sshd_config && \
    echo 'PermitTunnel yes' >> /etc/ssh/sshd_config && \
    echo 'ClientAliveInterval 60' >> /etc/ssh/sshd_config && \
    echo 'MaxSessions 100' >> /etc/ssh/sshd_config
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
DOCKEREOF

docker build -t ssh-proxy-image /root/ -f /root/Dockerfile.ssh >> "$LOG" 2>&1

docker run -d --name ssh-proxy --restart unless-stopped \
    --network host --cap-add=NET_ADMIN --privileged \
    ssh-proxy-image >> "$LOG" 2>&1

sleep 3

docker exec ssh-proxy bash -c "
    useradd -rm -d /home/$SSH_USER -s /bin/bash -G sudo,root $SSH_USER 2>/dev/null || true
    echo '$SSH_USER:$SSH_PASS' | chpasswd
    echo 'root:$ROOT_PASS' | chpasswd
    echo '$SSH_USER ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/$SSH_USER
" >> "$LOG" 2>&1

docker exec ssh-proxy service ssh restart >> "$LOG" 2>&1 || docker exec ssh-proxy kill -HUP 1 2>/dev/null

# ============================================
# PYTHON SNI PROXY (Fallsback)
# ============================================
cat > /usr/local/bin/sni-proxy.py << 'PYEOF'
#!/usr/bin/env python3
import socket
import ssl
import threading
import sys

LISTEN_PORTS = [80, 443, 8080, 3128, 8443, 8888]

def handle_client(client_sock, addr):
    try:
        # Read first bytes to determine if TLS
        peek = client_sock.recv(4096, socket.MSG_PEEK)
        
        if peek and peek[0] == 0x16:  # TLS Client Hello
            # Extract SNI
            try:
                # Simple SNI extraction from Client Hello
                # Skip: record header(5) + handshake header(4) + client version(2) + random(32)
                offset = 5 + 4 + 2 + 32
                # Skip session ID
                session_id_len = peek[offset]
                offset += 1 + session_id_len
                # Cipher suites
                cipher_len = int.from_bytes(peek[offset:offset+2], 'big')
                offset += 2 + cipher_len
                # Compression methods
                comp_len = peek[offset]
                offset += 1 + comp_len
                # Extensions
                ext_len = int.from_bytes(peek[offset:offset+2], 'big')
                offset += 2
                end_offset = offset + ext_len
                
                sni = None
                while offset < end_offset:
                    ext_type = int.from_bytes(peek[offset:offset+2], 'big')
                    ext_data_len = int.from_bytes(peek[offset+2:offset+4], 'big')
                    if ext_type == 0:  # SNI extension
                        # Skip server_name_list length (2 bytes) + first entry type (1 byte)
                        sni_offset = offset + 4 + 2 + 1
                        sni_len = int.from_bytes(peek[sni_offset:sni_offset+2], 'big')
                        sni = peek[sni_offset+2:sni_offset+2+sni_len].decode('utf-8', errors='ignore')
                        break
                    offset += 4 + ext_data_len
                
                if sni:
                    # Connect to real server
                    target = (sni, 443)
                    remote = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                    remote.settimeout(10)
                    remote.connect(target)
                    
                    # Send the peeked data
                    full_data = client_sock.recv(65536)
                    remote.send(full_data)
                    
                    # Relay
                    def relay(src, dst):
                        try:
                            while True:
                                data = src.recv(65536)
                                if not data:
                                    break
                                dst.send(data)
                        except:
                            pass
                        finally:
                            try: src.close()
                            except: pass
                            try: dst.close()
                            except: pass
                    
                    t1 = threading.Thread(target=relay, args=(client_sock, remote))
                    t2 = threading.Thread(target=relay, args=(remote, client_sock))
                    t1.daemon = True
                    t2.daemon = True
                    t1.start()
                    t2.start()
                    t1.join(timeout=30)
                    return
            except:
                pass
        
        # Non-TLS or failed SNI - return status
        response = b'HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{"status":"ok","proxy":"universal-sni-proxy","help":"Connect using SNI hostname"}\r\n'
        client_sock.send(response)
        client_sock.close()
        
    except Exception as e:
        try:
            client_sock.close()
        except:
            pass

def main():
    for port in LISTEN_PORTS:
        def start_listener(p):
            try:
                server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                server.bind(('0.0.0.0', p))
                server.listen(100)
                print(f"[LISTEN] Port {p}")
                while True:
                    client, addr = server.accept()
                    t = threading.Thread(target=handle_client, args=(client, addr))
                    t.daemon = True
                    t.start()
            except Exception as e:
                print(f"[ERROR] Port {p}: {e}")
        
        threading.Thread(target=start_listener, args=(port,), daemon=True).start()
    
    import time
    while True:
        time.sleep(60)

if __name__ == '__main__':
    main()
PYEOF

chmod +x /usr/local/bin/sni-proxy.py

# Start Python SNI proxy (fallback)
nohup python3 /usr/local/bin/sni-proxy.py >> /var/log/sni-proxy.log 2>&1 &

echo "SETUP_COMPLETE" > /var/log/proxy-setup-complete.log
echo "[$(date)] Universal SNI Proxy setup complete" >> "$LOG"
STARTUPEOF

chmod +x "$TMP_DIR/startup-script.sh"
success "Startup script built"

# ============================================
# DEPLOY VM
# ============================================
if gcloud compute instances describe "$SERVICE_NAME" --zone="$ZONE" --quiet 2>/dev/null; then
    warn "Removing existing VM: $SERVICE_NAME"
    gcloud compute instances delete "$SERVICE_NAME" --zone="$ZONE" --quiet 2>/dev/null
    sleep 5
fi

gcloud compute instances create "$SERVICE_NAME" \
    --image-family=ubuntu-2204-lts \
    --image-project=ubuntu-os-cloud \
    --machine-type="$MACHINE_TYPE" \
    --zone="$ZONE" \
    --tags="$(echo $FIREWALL_RULES | tr ' ' ',')" \
    --metadata-from-file startup-script="$TMP_DIR/startup-script.sh" \
    --metadata="SSH_USER=$SSH_USER,SSH_PASS=$SSH_PASS,ROOT_PASS=$ROOT_PASS,SERVICE_NAME=$SERVICE_NAME" \
    --boot-disk-size=30GB \
    --boot-disk-type=pd-standard \
    --quiet 2>/dev/null

success "VM created: $SERVICE_NAME"
rm -rf "$TMP_DIR"

# ============================================
# GET PUBLIC IP
# ============================================
sleep 25
PUBLIC_IP=$(gcloud compute instances describe "$SERVICE_NAME" --zone="$ZONE" --format='get(networkInterfaces[0].accessConfigs[0].natIP)' 2>/dev/null || echo "")

if [ -z "$PUBLIC_IP" ]; then
    echo -e "${BG_RED}${WHITE} [FATAL] Could not get public IP. ${RESET}"
    exit 1
fi
success "Public IP: $PUBLIC_IP"

# ============================================
# WAIT FOR SERVICES
# ============================================
info "Waiting for services to start..."
MAX_WAIT=240
WAITED=0
PORTS_READY=false

while [ $WAITED -lt $MAX_WAIT ]; do
    for port in 80 443 8080 22 3128; do
        if nc -zv -w 2 "$PUBLIC_IP" "$port" 2>/dev/null; then
            PORTS_READY=true
        fi
    done
    if [ "$PORTS_READY" = true ]; then
        break
    fi
    sleep 15
    WAITED=$((WAITED + 15))
    printf "\r  [*] Waiting... %ss / %ss" "$WAITED" "$MAX_WAIT"
done
echo ""

# ============================================
# FINAL OUTPUT
# ============================================
echo ""
echo -e "${BG_GREEN}${WHITE}${BOLD}                                                              ${RESET}"
echo -e "${BG_GREEN}${WHITE}${BOLD}     UNIVERSAL SNI PROXY SERVER DEPLOYED SUCCESSFULLY          ${RESET}"
echo -e "${BG_GREEN}${WHITE}${BOLD}                                                              ${RESET}"
echo ""

echo -e "${CYAN}${BOLD}  ╔══════════════════════════════════════════════════════════╗${RESET}"
echo -e "${CYAN}${BOLD}  ║  SERVER DETAILS                                          ║${RESET}"
echo -e "${CYAN}${BOLD}  ╚══════════════════════════════════════════════════════════╝${RESET}"
echo ""
echo -e "  ${WHITE}Server IP:${RESET}     ${GREEN}${BOLD}$PUBLIC_IP${RESET}"
echo -e "  ${WHITE}SSH User:${RESET}      ${BOLD}$SSH_USER${RESET}"
echo -e "  ${WHITE}SSH Pass:${RESET}      ${BOLD}$SSH_PASS${RESET}"
echo -e "  ${WHITE}Root Pass:${RESET}     ${BOLD}$ROOT_PASS${RESET}"
echo ""
echo -e "  ${YELLOW}${BOLD}LISTENING PORTS:${RESET}"
echo -e "  ${WHITE}  80   (HTTP)${RESET}"
echo -e "  ${WHITE}  443  (HTTPS/SNI)${RESET}"
echo -e "  ${WHITE}  22   (SSH)${RESET}"
echo -e "  ${WHITE}  8080 (HTTP/SNI)${RESET}"
echo -e "  ${WHITE}  3128 (Squid Forward Proxy)${RESET}"
echo -e "  ${WHITE}  8443 (HTTPS/SNI)${RESET}"
echo -e "  ${WHITE}  8888 (HTTP/SNI)${RESET}"
echo ""

echo -e "${CYAN}${BOLD}  ╔══════════════════════════════════════════════════════════╗${RESET}"
echo -e "${CYAN}${BOLD}  ║  HOW TO USE                                              ║${RESET}"
echo -e "${CYAN}${BOLD}  ╚══════════════════════════════════════════════════════════╝${RESET}"
echo ""
echo -e "  ${GREEN}[Direct Host Connection]${RESET}"
echo -e "  ${WHITE}curl --resolve smart.com.ph:443:$PUBLIC_IP https://smart.com.ph/${RESET}"
echo ""
echo -e "  ${GREEN}[Any Host Through Proxy]${RESET}"
echo -e "  ${WHITE}curl --resolve google.com:443:$PUBLIC_IP https://google.com/${RESET}"
echo -e "  ${WHITE}curl --resolve youtube.com:443:$PUBLIC_IP https://youtube.com/${RESET}"
echo ""
echo -e "  ${GREEN}[SSH Tunnel Through Proxy]${RESET}"
echo -e "  ${WHITE}ssh $SSH_USER@$PUBLIC_IP -p 22${RESET}"
echo ""
echo -e "  ${GREEN}[Squid Forward Proxy]${RESET}"
echo -e "  ${WHITE}curl -x http://$PUBLIC_IP:3128 https://google.com/${RESET}"
echo ""

echo -e "${CYAN}${BOLD}  ╔══════════════════════════════════════════════════════════╗${RESET}"
echo -e "${CYAN}${BOLD}  ║  HTTP CUSTOM / INJECTOR CONFIG                           ║${RESET}"
echo -e "${CYAN}${BOLD}  ╚══════════════════════════════════════════════════════════╝${RESET}"
echo ""
echo -e "  ${MAGENTA}Proxy:${RESET} $PUBLIC_IP:443"
echo -e "  ${MAGENTA}SNI:${RESET}   smart.com.ph (or any host)"
echo -e "  ${MAGENTA}Port:${RESET}  443"
echo ""

echo -e "${CYAN}${BOLD}  ╔═══════════════════════════════════════════════
