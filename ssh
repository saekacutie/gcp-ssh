    echo "  |   ${WHITE}\ \ / /${CYAN}  __ \ ${WHITE}| \ |${CYAN}/ ____${WHITE}| \ |${CYAN}| |    ${CYAN}  |"
    echo "  |   ${WHITE} \ V /${CYAN}| |__) |${WHITE}|  \|${CYAN}| |__ ${WHITE}|  \|${CYAN}| |    ${CYAN}  |"
    echo "  |   ${WHITE}  > < ${CYAN}|  ___/ ${WHITE}| . \`${CYAN}|  __|${WHITE}| . \`${CYAN}| |    ${CYAN}  |"
    echo "  |   ${WHITE} / . \\\\${CYAN}| |   ${WHITE}_| |\  ${CYAN}| |___${WHITE}| |\  ${CYAN}| |____${CYAN}  |"
    echo "  |   ${WHITE}/_/ \_\\${CYAN}\_|  ${WHITE}(_)_| \_${CYAN}\_____${WHITE}|_| \_${CYAN}|______| ${CYAN}  |"
