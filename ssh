#!/bin/bash
# ============================================
# Universal SSH Proxy Deployer for GCP Cloud Shell
# Modes: Cloud Run (no VM quota) / Compute Engine (full VPN)
# ============================================
set -o pipefail
trap 'echo -e "\033[1;31m[ERROR] Script failed at line $LINENO.\033[0m" >&2; exit 1' ERR

clear
# ------------------------ COLORS ------------------------
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; MAGENTA='\033[0;35m'; CYAN='\033[0;36m'
WHITE='\033[1;37m'; BOLD='\033[1m'; RESET='\033[0m'

# ------------------------ FUNCTIONS ------------------------
check_gcloud() {
    if ! command -v gcloud &>/dev/null; then
        echo -e "${RED}[FATAL] gcloud CLI not found. Run in Cloud Shell.${RESET}"
        exit 1
    fi
    ACCOUNT=$(gcloud auth list --filter=status:ACTIVE --format="value(account)" 2>/dev/null || echo "")
    if [ -z "$ACCOUNT" ]; then
        echo -e "${RED}[FATAL] Not authenticated. Run 'gcloud auth login'.${RESET}"
        exit 1
    fi
    export PROJECT_ID=$(gcloud config get-value project 2>/dev/null || echo "")
    if [ -z "$PROJECT_ID" ]; then
        PROJECT_ID=$(gcloud projects list --format='value(projectId)' --limit=1 2>/dev/null || echo "")
        if [ -z "$PROJECT_ID" ]; then
            echo -e "${RED}[FATAL] No project. Create one at console.cloud.google.com${RESET}"
            exit 1
        fi
        gcloud config set project "$PROJECT_ID" -q
    fi
}

enable_apis() {
    echo -e "${CYAN}Enabling required APIs...${RESET}"
    gcloud services enable run.googleapis.com cloudbuild.googleapis.com compute.googleapis.com --quiet 2>/dev/null
    echo -e "${GREEN}APIs enabled.${RESET}"
}

# ------------------------ UI BANNER ------------------------
echo -e "${CYAN}${BOLD}"
echo "╔══════════════════════════════════════════════════════════╗"
echo "║       UNIVERSAL SSH PROXY DEPLOYER v1.0                  ║"
echo "║       Cloud Run (No VM Quota) or Compute Engine          ║"
echo "╚══════════════════════════════════════════════════════════╝"
echo -e "${RESET}"

check_gcloud
enable_apis

# ------------------------ MODE SELECTION --------------------
echo -e "\n${YELLOW}Select deployment mode:${RESET}"
echo -e "  ${GREEN}1${RESET} - Cloud Run SSH (serverless, NO VM quota, recommended for Qwiklabs)"
echo -e "  ${GREEN}2${RESET} - Compute Engine VM Proxy (full VPN suite, requires VM quota)"
echo -ne "${WHITE}Choice [1]: ${RESET}"
read MODE
MODE=${MODE:-1}

# ------------------------ CREDENTIALS -----------------------
echo -ne "\n${WHITE}SSH username [proxyuser]: ${RESET}"
read SSH_USER; SSH_USER=${SSH_USER:-proxyuser}
echo -ne "${WHITE}SSH password (leave empty to auto‑generate): ${RESET}"
read -s SSH_PASS; echo
if [ -z "$SSH_PASS" ]; then
    SSH_PASS=$(openssl rand -base64 12 | tr -d "=+/" | cut -c1-12)
    echo -e "${GREEN}Generated password: $SSH_PASS${RESET}"
fi

# ------------------------ CLOUD RUN MODE --------------------
if [ "$MODE" == "1" ]; then
    echo -e "\n${MAGENTA}${BOLD}🚀 Deploying Cloud Run SSH Server...${RESET}"
    
    # Create temporary folder
    TMPDIR=$(mktemp -d)
    cd "$TMPDIR"
    
    # Write Dockerfile
    cat > Dockerfile << 'EOF'
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y openssh-server wget sudo && \
    mkdir -p /var/run/sshd && \
    wget -q https://github.com/vi/websocat/releases/latest/download/websocat.x86_64-unknown-linux-musl -O /usr/local/bin/websocat && \
    chmod +x /usr/local/bin/websocat && \
    echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config && \
    echo 'PasswordAuthentication yes' >> /etc/ssh/sshd_config && \
    echo 'Port 2222' >> /etc/ssh/sshd_config && \
    echo 'ClientAliveInterval 60' >> /etc/ssh/sshd_config && \
    echo 'GatewayPorts yes' >> /etc/ssh/sshd_config
EXPOSE 8080
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
EOF

    # Write entrypoint with user/pass substitution (will be done via sed later)
    cat > entrypoint.sh << 'ENTRY'
#!/bin/bash
useradd -m -s /bin/bash $SSH_USER 2>/dev/null
echo "$SSH_USER:$SSH_PASS" | chpasswd
echo "$SSH_USER ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$SSH_USER
/usr/sbin/sshd -p 2222 &
exec websocat -E --binary ws-l:0.0.0.0:8080 tcp:127.0.0.1:2222
ENTRY

    sed -i "s/\$SSH_USER/$SSH_USER/g" entrypoint.sh
    sed -i "s/\$SSH_PASS/$SSH_PASS/g" entrypoint.sh

    # Deploy to Cloud Run
    SERVICE_NAME="ssh-server-$(date +%s)"
    echo -e "${CYAN}Building container...${RESET}"
    gcloud builds submit --tag gcr.io/$PROJECT_ID/$SERVICE_NAME --quiet --machine-type=e2-highcpu-8 --timeout=600 2>/dev/null

    echo -e "${CYAN}Deploying to Cloud Run...${RESET}"
    gcloud run deploy $SERVICE_NAME \
        --image gcr.io/$PROJECT_ID/$SERVICE_NAME \
        --platform managed \
        --region us-central1 \
        --allow-unauthenticated \
        --port 8080 \
        --timeout=3600 \
        --quiet 2>/dev/null

    # Get the public URL
    URL=$(gcloud run services describe $SERVICE_NAME --region us-central1 --format='value(status.url)' 2>/dev/null)
    URL=${URL#https://}

    cd - >/dev/null
    rm -rf "$TMPDIR"

    echo ""
    echo -e "${GREEN}${BOLD}╔══════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${GREEN}${BOLD}║     CLOUD RUN SSH SERVER DEPLOYED SUCCESSFULLY          ║${RESET}"
    echo -e "${GREEN}${BOLD}╚══════════════════════════════════════════════════════════╝${RESET}"
    echo ""
    echo -e "${WHITE}SSH User:${RESET}     ${BOLD}$SSH_USER${RESET}"
    echo -e "${WHITE}SSH Password:${RESET} ${BOLD}$SSH_PASS${RESET}"
    echo -e "${WHITE}Server URL:${RESET}   ${BOLD}$URL${RESET}"
    echo ""
    echo -e "${YELLOW}To connect from your client:${RESET}"
    echo "  1. Install websocat (https://github.com/vi/websocat/releases)"
    echo "  2. Run:"
    echo -e "     ${BOLD}ssh -o ProxyCommand='websocat --binary - ws://$URL' $SSH_USER@dummy${RESET}"
    echo ""
    echo -e "${YELLOW}SOCKS5 tunnel (once connected):${RESET}"
    echo -e "     ${BOLD}ssh -o ProxyCommand='websocat --binary - ws://$URL' -D 1080 -N $SSH_USER@dummy${RESET}"
    echo ""

# ------------------------ COMPUTE ENGINE VM MODE --------------------
elif [ "$MODE" == "2" ]; then
    # Custom VM settings
    echo -ne "\n${WHITE}VM name [proxy-vm]: ${RESET}"
    read VM_NAME; VM_NAME=${VM_NAME:-proxy-vm}
    echo -ne "${WHITE}Zone [us-central1-a]: ${RESET}"
    read ZONE; ZONE=${ZONE:-us-central1-a}
    echo -ne "${WHITE}Machine type [e2-micro]: ${RESET}"
    read MACHINE; MACHINE=${MACHINE:-e2-micro}
    ROOT_PASS=$(openssl rand -base64 12 | tr -d "=+/" | cut -c1-12)

    echo -e "\n${MAGENTA}${BOLD}🚀 Deploying Compute Engine VM Proxy...${RESET}"

    # Firewall
    for port in 22 80 443 8080 3128; do
        gcloud compute firewall-rules delete "allow-${VM_NAME}-${port}" --quiet 2>/dev/null || true
        gcloud compute firewall-rules create "allow-${VM_NAME}-${port}" \
            --allow tcp:${port} --direction=INGRESS --priority=1000 -q 2>/dev/null
    done

    # Startup script
    TMPDIR=$(mktemp -d)
    cat > "$TMPDIR/startup.sh" << 'BOOT'
#!/bin/bash
exec &>/var/log/startup.log
apt-get update -qq && apt-get install -y -qq nginx squid openssh-server docker.io sshpass

# SSL cert
IP=$(hostname -I | awk '{print $1}')
openssl req -x509 -newkey rsa:2048 -keyout /etc/nginx/ssl.key -out /etc/nginx/ssl.crt -days 3650 -nodes -subj "/CN=$IP"

# Nginx SNI proxy
cat > /etc/nginx/nginx.conf << NG
user www-data; worker_processes auto; pid /run/nginx.pid;
events { worker_connections 4096; }
stream {
    map \$ssl_preread_server_name \$backend { default \$ssl_preread_server_name:443; }
    server { listen 443; proxy_pass \$backend; ssl_preread on; }
    server { listen 8080; proxy_pass \$backend; ssl_preread on; }
    server { listen 8443; proxy_pass \$backend; ssl_preread on; }
    server { listen 8888; proxy_pass \$backend; ssl_preread on; }
    server { listen 80; proxy_pass 127.0.0.1:8889; }
}
http { sendfile on; tcp_nopush on; include /etc/nginx/mime.types; default_type application/octet-stream;
    server { listen 127.0.0.1:8889; location / { return 200 "{\"status\":\"ok\"}"; } }
}
NG
systemctl restart nginx

# Squid
cat > /etc/squid/squid.conf << SQ
http_port 0.0.0.0:3128
acl all src 0.0.0.0/0; http_access allow all
forwarded_for delete; via off
SQ
systemctl restart squid

# Docker SSH
docker rm -f sshd 2>/dev/null || true
cat > /root/Dockerfile << DK
FROM ubuntu:22.04
RUN apt-get update && apt-get install -y openssh-server && mkdir -p /var/run/sshd
RUN echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config && \
    echo 'PasswordAuthentication yes' >> /etc/ssh/sshd_config && \
    echo 'ClientAliveInterval 60' >> /etc/ssh/sshd_config
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]
DK
docker build -t sshd-img /root/
docker run -d --name sshd --restart unless-stopped --network host sshd-img
sleep 3
docker exec sshd bash -c "useradd -m -s /bin/bash $SSH_USER 2>/dev/null; echo '$SSH_USER:$SSH_PASS' | chpasswd; echo 'root:$ROOT_PASS' | chpasswd"
echo "READY" > /var/log/ready
BOOT

    # Replace variables in startup script
    sed -i "s/\$SSH_USER/$SSH_USER/g" "$TMPDIR/startup.sh"
    sed -i "s/\$SSH_PASS/$SSH_PASS/g" "$TMPDIR/startup.sh"
    sed -i "s/\$ROOT_PASS/$ROOT_PASS/g" "$TMPDIR/startup.sh"

    # Delete old VM if exists
    gcloud compute instances delete "$VM_NAME" --zone="$ZONE" --quiet 2>/dev/null || true
    gcloud compute instances create "$VM_NAME" \
        --image-family=ubuntu-2204-lts --image-project=ubuntu-os-cloud \
        --machine-type="$MACHINE" --zone="$ZONE" \
        --metadata-from-file startup-script="$TMPDIR/startup.sh" \
        --metadata="SSH_USER=$SSH_USER,SSH_PASS=$SSH_PASS,ROOT_PASS=$ROOT_PASS" \
        --boot-disk-size=30GB --boot-disk-type=pd-standard --quiet 2>/dev/null

    # Wait for IP
    echo -e "${CYAN}Waiting for public IP...${RESET}"
    for i in {1..24}; do
        PUB_IP=$(gcloud compute instances describe "$VM_NAME" --zone="$ZONE" --format='get(networkInterfaces[0].accessConfigs[0].natIP)' 2>/dev/null || echo "")
        [ -n "$PUB_IP" ] && break
        sleep 10
    done
    if [ -z "$PUB_IP" ]; then echo -e "${RED}Failed to obtain IP.${RESET}"; exit 1; fi

    rm -rf "$TMPDIR"

    echo ""
    echo -e "${GREEN}${BOLD}╔══════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${GREEN}${BOLD}║     VM PROXY DEPLOYED SUCCESSFULLY                       ║${RESET}"
    echo -e "${GREEN}${BOLD}╚══════════════════════════════════════════════════════════╝${RESET}"
    echo ""
    echo -e "${WHITE}Server IP:${RESET}     ${GREEN}$PUB_IP${RESET}"
    echo -e "${WHITE}SSH User:${RESET}      ${BOLD}$SSH_USER${RESET}"
    echo -e "${WHITE}SSH Password:${RESET}  ${BOLD}$SSH_PASS${RESET}"
    echo -e "${WHITE}Root Password:${RESET} ${BOLD}$ROOT_PASS${RESET}"
    echo -e "${WHITE}Open Ports:${RESET}     22, 80, 443, 8080, 3128, 8443, 8888"
    echo ""
    echo -e "${YELLOW}Direct SSH: ${BOLD}ssh $SSH_USER@$PUB_IP${RESET}"
    echo -e "${YELLOW}SOCKS5 VPN: ${BOLD}ssh -D 1080 -N $SSH_USER@$PUB_IP${RESET}"
    echo -e "${YELLOW}Squid Proxy: ${BOLD}curl -x http://$PUB_IP:3128 https://example.com${RESET}"
    echo -e "${YELLOW}SNI Proxy: ${BOLD}curl --resolve example.com:443:$PUB_IP https://example.com${RESET}"
    echo ""
fi
