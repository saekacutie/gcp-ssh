#!/bin/bash
# ============================================
# VPN SSH + TLS PROXY SERVER DEPLOYMENT v5.0
# GCP Cloud Shell | No Qwiklabs | Direct Deploy
# Target Server Routing | ASCII Icons | Typing Animation
# ============================================

clear

# ============================================
# COLOR DEFINITIONS
# ============================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'
BG_RED='\033[41m'
BG_GREEN='\033[42m'
BG_BLUE='\033[44m'

# ============================================
# TYPING ANIMATION
# ============================================
type_text() {
    local text="$1"
    local delay="${2:-0.005}"
    for ((i=0; i<${#text}; i++)); do
        printf "%s" "${text:$i:1}"
        sleep "$delay"
    done
    echo ""
}

type_slow() {
    local text="$1"
    for ((i=0; i<${#text}; i++)); do
        printf "%s" "${text:$i:1}"
        sleep 0.02
    done
    echo ""
}

# ============================================
# SPINNER
# ============================================
spinner() {
    local pid=$1
    local text="$2"
    local frames='|/-\'
    local i=0
    while kill -0 $pid 2>/dev/null; do
        i=$(( (i+1) %4 ))
        printf "\r  [%s] %s" "${frames:$i:1}" "$text"
        sleep 0.15
    done
    printf "\r  [OK] %s %s[DONE]%s\n" "$text" "${GREEN}" "${RESET}"
}

# ============================================
# ERROR HANDLING
# ============================================
set -e
trap 'echo -e "\n${BG_RED}${WHITE} [FATAL] Script failed at line $LINENO ${RESET}"; exit 1' ERR

error_exit() {
    echo -e "\n${BG_RED}${WHITE} [FATAL] $1 ${RESET}"
    exit 1
}

success() { echo -e "  ${GREEN}[OK]${RESET} $1"; }
info()    { echo -e "  ${CYAN}[*]${RESET} $1"; }
warn()    { echo -e "  ${YELLOW}[!]${RESET} $1"; }
section() { echo -e "\n${BOLD}${WHITE}[$1]${RESET} ${CYAN}$2${RESET}"; }

