# ============================================
# CONFIGURATION INPUT
# ============================================
get_config() {
    echo ""
    echo -e "${YELLOW}${BOLD}  =============================================${RESET}"
    echo -e "${YELLOW}${BOLD}  | CONFIGURE VPN SSH + TLS PROXY SERVER      |${RESET}"
    echo -e "${YELLOW}${BOLD}  =============================================${RESET}"
    echo ""
    
    type_text "  Enter configuration values (or press Enter for defaults):" 0.01
    
    echo ""
    echo -ne "  ${CYAN}[?]${RESET} ${WHITE}Service Name${RESET} ${DIM}[vpn-ssh-server]${RESET}: "
    read SERVICE_NAME
    SERVICE_NAME=${SERVICE_NAME:-vpn-ssh-server}
    
    echo -ne "  ${CYAN}[?]${RESET} ${WHITE}SSH Username${RESET} ${DIM}[tunnelvpn]${RESET}: "
    read SSH_USER
    SSH_USER=${SSH_USER:-tunnelvpn}
    
    echo -ne "  ${CYAN}[?]${RESET} ${WHITE}SSH Password${RESET} ${DIM}[auto-generate]${RESET}: "
    read -s SSH_PASS
    echo ""
    if [ -z "$SSH_PASS" ]; then
        SSH_PASS=$(openssl rand -base64 18 | tr -d "=+/" | cut -c1-20)
        type_text "  ${GREEN}[*] Generated password: ${WHITE}${BOLD}$SSH_PASS${RESET}" 0.005
    fi
    
    echo -ne "  ${CYAN}[?]${RESET} ${WHITE}Root Password${RESET} ${DIM}[auto-generate]${RESET}: "
    read -s ROOT_PASS
    echo ""
    if [ -z "$ROOT_PASS" ]; then
        ROOT_PASS=$(openssl rand -base64 16 | tr -d "=+/" | cut -c1-16)
        type_text "  ${GREEN}[*] Generated root password: ${WHITE}${BOLD}$ROOT_PASS${RESET}" 0.005
    fi
    
    echo -ne "  ${CYAN}[?]${RESET} ${WHITE}SSH Port${RESET} ${DIM}[22]${RESET}: "
    read SSH_PORT
    SSH_PORT=${SSH_PORT:-22}
    # Validate port
    if ! [[ "$SSH_PORT" =~ ^[0-9]+$ ]] || [ "$SSH_PORT" -lt 1 ] || [ "$SSH_PORT" -gt 65535 ]; then
        warn "Invalid port. Using default 22."
        SSH_PORT=22
    fi
    
    echo -ne "  ${CYAN}[?]${RESET} ${WHITE}TLS/SSL Port${RESET} ${DIM}[443]${RESET}: "
    read TLS_PORT
    TLS_PORT=${TLS_PORT:-443}
    if ! [[ "$TLS_PORT" =~ ^[0-9]+$ ]] || [ "$TLS_PORT" -lt 1 ] || [ "$TLS_PORT" -gt 65535 ]; then
        warn "Invalid port. Using default 443."
        TLS_PORT=443
    fi
    
    echo ""
    echo -ne "  ${CYAN}[?]${RESET} ${WHITE}Target Server Domain${RESET} ${DIM}(e.g., example.panel.site.com)${RESET}: "
    read TARGET_DOMAIN
    
    if [ -z "$TARGET_DOMAIN" ]; then
        warn "No target server provided. SSH will work without proxy routing."
        TARGET_DOMAIN=""
    fi
    
    echo -ne "  ${CYAN}[?]${RESET} ${WHITE}Zone${RESET} ${DIM}[us-central1-a]${RESET}: "
    read ZONE
    ZONE=${ZONE:-us-central1-a}
    
    echo -ne "  ${CYAN}[?]${RESET} ${WHITE}Machine Type${RESET} ${DIM}[e2-micro]${RESET}: "
    read MACHINE_TYPE
    MACHINE_TYPE=${MACHINE_TYPE:-e2-micro}
    
    echo ""
    echo -e "${YELLOW}${BOLD}  =============================================${RESET}"
    echo -e "${YELLOW}${BOLD}  | CONFIGURATION SUMMARY                     |${RESET}"
    echo -e "${YELLOW}${BOLD}  =============================================${RESET}"
    echo -e "  ${CYAN}Service:${RESET}     ${WHITE}$SERVICE_NAME${RESET}"
    echo -e "  ${CYAN}SSH User:${RESET}     ${WHITE}$SSH_USER${RESET}"
    echo -e "  ${CYAN}SSH Port:${RESET}     ${WHITE}$SSH_PORT${RESET}"
    echo -e "  ${CYAN}TLS Port:${RESET}     ${WHITE}$TLS_PORT${RESET}"
    echo -e "  ${CYAN}Target:${RESET}       ${WHITE}${TARGET_DOMAIN:-NONE}${RESET}"
    echo -e "  ${CYAN}Zone:${RESET}         ${WHITE}$ZONE${RESET}"
    echo -e "  ${CYAN}Machine:${RESET}      ${WHITE}$MACHINE_TYPE${RESET}"
    echo -e "${YELLOW}${BOLD}  =============================================${RESET}"
    echo ""
    
    echo -ne "  ${CYAN}[?]${RESET} ${WHITE}Proceed with deployment? (Y/n): ${RESET}"
    read CONFIRM
    if [ "$CONFIRM" = "n" ] || [ "$CONFIRM" = "N" ]; then
        echo -e "\n  ${RED}[X] Deployment cancelled.${RESET}"
        exit 0
    fi
}

# ============================================
# CHECK PREREQUISITES
# ============================================
check_prereqs() {
    section "1/8" "CHECKING PREREQUISITES"
    
    if ! command -v gcloud &> /dev/null; then
        error_exit "gcloud CLI not found. Are you in Cloud Shell?"
    fi
    success "gcloud CLI verified"
    
    ACCOUNT=$(gcloud auth list --filter=status:ACTIVE --format="value(account)" 2>/dev/null || echo "")
    if [ -z "$ACCOUNT" ]; then
        error_exit "Not authenticated. Run: gcloud auth login"
    fi
    success "Authenticated: $ACCOUNT"
    
    PROJECT_ID=$(gcloud config get-value project 2>/dev/null || echo "")
    if [ -z "$PROJECT_ID" ]; then
        PROJECT_ID=$(gcloud projects list --format='value(projectId)' --limit=1 2>/dev/null || echo "")
        if [ -z "$PROJECT_ID" ]; then
            error_exit "No project found. Create one at console.cloud.google.com"
        fi
        gcloud config set project "$PROJECT_ID" 2>/dev/null
    fi
    success "Project: $PROJECT_ID"
}

# ============================================
# RESOLVE TARGET SERVER IPs
# ============================================
resolve_target() {
    section "2/8" "RESOLVING TARGET SERVER"
    
    if [ -z "$TARGET_DOMAIN" ]; then
        warn "No target domain provided. Skipping IP resolution."
        TARGET_IPS=""
        return
    fi
    
    type_text "  [*] Resolving $TARGET_DOMAIN ..." 0.01
    
    # Resolve IPs
    TARGET_IPS=$(dig +short "$TARGET_DOMAIN" A 2>/dev/null | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u || echo "")
    
    if [ -z "$TARGET_IPS" ]; then
        # Fallback to host command
        TARGET_IPS=$(host "$TARGET_DOMAIN" 2>/dev/null | grep "has address" | awk '{print $NF}' | sort -u || echo "")
    fi
    
    if [ -z "$TARGET_IPS" ]; then
        warn "Could not resolve $TARGET_DOMAIN. Using domain as-is."
        TARGET_IPS="$TARGET_DOMAIN"
        TARGET_COUNT=1
    else
        TARGET_COUNT=$(echo "$TARGET_IPS" | wc -l)
        success "Resolved $TARGET_COUNT IP(s) from $TARGET_DOMAIN"
        echo ""
        echo -e "  ${CYAN}  Resolved IPs:${RESET}"
        while IFS= read -r ip; do
            echo -e "  ${WHITE}    -> $ip${RESET}"
        done <<< "$TARGET_IPS"
    fi
    echo ""
}

# ============================================
# ENABLE APIS
# ============================================
enable_apis() {
    section "3/8" "ENABLING APIS"
    gcloud services enable compute.googleapis.com --quiet 2>/dev/null &
    spinner $! "Enabling Compute Engine API..."
}

# ============================================
# CREATE FIREWALL
# ============================================
create_firewall() {
    section "4/8" "CONFIGURING FIREWALL"
    
    FIREWALL_SSH="allow-${SERVICE_NAME}-ssh-${SSH_PORT}"
    FIREWALL_TLS="allow-${SERVICE_NAME}-tls-${TLS_PORT}"
    
    gcloud compute firewall-rules delete "$FIREWALL_SSH" --quiet 2>/dev/null || true
    gcloud compute firewall-rules delete "$FIREWALL_TLS" --quiet 2>/dev/null || true
    
    gcloud compute firewall-rules create "$FIREWALL_SSH" \
        --allow tcp:${SSH_PORT} \
        --direction=INGRESS \
        --priority=1000 \
        --quiet 2>/dev/null &
    spinner $! "Creating SSH firewall rule (port $SSH_PORT)..."
    
    gcloud compute firewall-rules create "$FIREWALL_TLS" \
        --allow tcp:${TLS_PORT} \
        --direction=INGRESS \
        --priority=1000 \
        --quiet 2>/dev/null &
    spinner $! "Creating TLS firewall rule (port $TLS_PORT)..."
}

# ============================================
# BUILD STARTUP SCRIPT
# ============================================
build_startup() {
    section "5/8" "BUILDING DEPLOYMENT CONFIG"
    
    # Prepare target IPs list for Docker
    TARGET_IPS_LIST=""
    if [ -n "$TARGET_IPS" ]; then
        TARGET_IPS_LIST=$(echo "$TARGET_IPS" | tr '\n' ',' | sed 's/,$//')
    fi
    
    TMP_DIR=$(mktemp -d)
    
    cat > "$TMP_DIR/startup-script.sh" << 'STARTUPEOF'
#!/bin/bash
set -e

# Read metadata
SSH_USER=$(curl -sf "http://metadata.google.internal/computeMetadata/v1/instance/attributes/SSH_USER" -H "Metadata-Flavor: Google" || echo "tunnelvpn")
SSH_PASS=$(curl -sf "http://metadata.google.internal/computeMetadata/v1/instance/attributes/SSH_PASS" -H "Metadata-Flavor: Google")
SSH_PORT=$(curl -sf "http://metadata.google.internal/computeMetadata/v1/instance/attributes/SSH_PORT" -H "Metadata-Flavor: Google" || echo "22")
TLS_PORT=$(curl -sf "http://metadata.google.internal/computeMetadata/v1/instance/attributes/TLS_PORT" -H "Metadata-Flavor: Google" || echo "443")
ROOT_PASS=$(curl -sf "http://metadata.google.internal/computeMetadata/v1/instance/attributes/ROOT_PASS" -H "Metadata-Flavor: Google")
TARGET_IPS=$(curl -sf "http://metadata.google.internal/computeMetadata/v1/instance/attributes/TARGET_IPS" -H "Metadata-Flavor: Google" || echo "")
TARGET_DOMAIN=$(curl -sf "http://metadata.google.internal/computeMetadata/v1/instance/attributes/TARGET_DOMAIN" -H "Metadata-Flavor: Google" || echo "")
SERVICE_NAME=$(curl -sf "http://metadata.google.internal/computeMetadata/v1/instance/attributes/SERVICE_NAME" -H "Metadata-Flavor: Google" || echo "vpn-ssh-server")

LOG="/var/log/vpn-setup.log"
echo "[$(date)] Starting setup: $SERVICE_NAME" > "$LOG"

# Update
apt-get update -y >> "$LOG" 2>&1
apt-get upgrade -y -qq >> "$LOG" 2>&1

# Install Docker
if ! command -v docker &> /dev/null; then
    curl -fsSL https://get.docker.com -o /tmp/get-docker.sh 2>> "$LOG"
    sh /tmp/get-docker.sh >> "$LOG" 2>&1
fi
systemctl enable docker 2>/dev/null || true
systemctl start docker 2>/dev/null || true

# Remove old container
docker rm -f ssh-server 2>/dev/null || true
docker rm -f stunnel-server 2>/dev/null || true

# Create Docker network
docker network create vpn-net 2>/dev/null || true

# Build SSH Dockerfile
cat > /root/Dockerfile.ssh << 'DOCKEREOF'
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server sudo curl wget net-tools iputils-ping iptables \
    procps htop nano vim tmux screen socat netcat-openbsd dnsutils \
    stunnel4 && apt-get clean && mkdir -p /var/run/sshd
RUN echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config && \
    echo 'PasswordAuthentication yes' >> /etc/ssh/sshd_config && \
    echo 'ClientAliveInterval 60' >> /etc/ssh/sshd_config && \
    echo 'ClientAliveCountMax 3' >> /etc/ssh/sshd_config && \
    echo 'TCPKeepAlive yes' >> /etc/ssh/sshd_config && \
    echo 'MaxSessions 100' >> /etc/ssh/sshd_config && \
    echo 'AllowTcpForwarding yes' >> /etc/ssh/sshd_config && \
    echo 'GatewayPorts yes' >> /etc/ssh/sshd_config && \
    echo 'PermitTunnel yes' >> /etc/ssh/sshd_config
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
DOCKEREOF

# Build SSH image
docker build -t ssh-image /root/ -f /root/Dockerfile.ssh >> "$LOG" 2>&1

# Run SSH container
docker run -d --name ssh-server --restart unless-stopped \
    --network host --cap-add=NET_ADMIN --cap-add=SYS_ADMIN --privileged \
    ssh-image >> "$LOG" 2>&1

sleep 3

# Configure user
docker exec ssh-server bash -c "
    useradd -rm -d /home/$SSH_USER -s /bin/bash -G sudo,root $SSH_USER 2>/dev/null || true
    echo '$SSH_USER:$SSH_PASS' | chpasswd
    echo 'root:$ROOT_PASS' | chpasswd
    echo '$SSH_USER ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/$SSH_USER
    sed -i 's/Port 22/Port $SSH_PORT/' /etc/ssh/sshd_config 2>/dev/null || echo 'Port $SSH_PORT' >> /etc/ssh/sshd_config
" >> "$LOG" 2>&1

# Restart SSH
docker exec ssh-server service ssh restart >> "$LOG" 2>&1 || docker exec ssh-server kill -HUP 1 2>/dev/null

# Configure Stunnel for TLS
if [ -n "$TARGET_IPS" ]; then
    # Create Stunnel config
    cat > /root/stunnel.conf << STUNCONF
[ssh-tls]
accept = 0.0.0.0:$TLS_PORT
connect = 127.0.0.1:$SSH_PORT
cert = /etc/stunnel/stunnel.pem
TIMEOUTclose = 0
STUNCONF

    # Generate self-signed cert
    mkdir -p /etc/stunnel
    openssl req -new -newkey rsa:2048 -days 3650 -nodes -x509 \
        -subj "/C=US/ST=State/L=City/O=VPN/CN=$TARGET_DOMAIN" \
        -keyout /etc/stunnel/stunnel.pem \
        -out /etc/stunnel/stunnel.pem 2>> "$LOG"
    
    # Run Stunnel container
    docker run -d --name stunnel-server --restart unless-stopped \
        --network host \
        -v /root/stunnel.conf:/etc/stunnel/stunnel.conf \
        -v /etc/stunnel/stunnel.pem:/etc/stunnel/stunnel.pem \
        ubuntu:22.04 bash -c "
            apt-get update && apt-get install -y stunnel4 && \
            stunnel /etc/stunnel/stunnel.conf
            tail -f /dev/null
        " >> "$LOG" 2>&1
fi

# Create combined hosts file with target IPs
if [ -n "$TARGET_IPS" ]; then
    echo "$TARGET_IPS" | tr ',' '\n' > /etc/vpn-target-hosts.txt
    echo "TARGET_HOSTS_FILE=/etc/vpn-target-hosts.txt" >> /etc/environment
fi

# Verify SSH
sleep 2
if docker exec ssh-server pgrep sshd > /dev/null 2>&1; then
    echo "SETUP_COMPLETE" > /var/log/vpn-setup-complete.log
    echo "[$(date)] SUCCESS" >> "$LOG"
else
    echo "[$(date)] FAILED" >> "$LOG"
    exit 1
fi
STARTUPEOF

    chmod +x "$TMP_DIR/startup-script.sh"
    success "Startup script built"
    echo "$TMP_DIR"
}

# ============================================
# DEPLOY VM
# ============================================
deploy_vm() {
    section "6/8" "DEPLOYING VIRTUAL MACHINE"
    
    TMP_DIR="$1"
    
    # Delete existing
    if gcloud compute instances describe "$SERVICE_NAME" --zone="$ZONE" --quiet 2>/dev/null; then
        warn "Existing VM found. Removing..."
        gcloud compute instances delete "$SERVICE_NAME" --zone="$ZONE" --quiet 2>/dev/null
        sleep 5
    fi
    
    # Prepare target IPs for metadata
    TARGET_IPS_META=""
    if [ -n "$TARGET_IPS" ]; then
        TARGET_IPS_META=$(echo "$TARGET_IPS" | tr '\n' ',' | sed 's/,$//')
    fi
    
    # Create VM
    gcloud compute instances create "$SERVICE_NAME" \
        --image-family=ubuntu-2204-lts \
        --image-project=ubuntu-os-cloud \
        --machine-type="$MACHINE_TYPE" \
        --zone="$ZONE" \
        --tags="$FIREWALL_SSH,$FIREWALL_TLS" \
        --metadata-from-file startup-script="$TMP_DIR/startup-script.sh" \
        --metadata="SSH_USER=$SSH_USER,SSH_PASS=$SSH_PASS,SSH_PORT=$SSH_PORT,TLS_PORT=$TLS_PORT,ROOT_PASS=$ROOT_PASS,TARGET_IPS=$TARGET_IPS_META,TARGET_DOMAIN=$TARGET_DOMAIN,SERVICE_NAME=$SERVICE_NAME" \
        --boot-disk-size=20GB \
        --boot-disk-type=pd-standard \
        --quiet 2>/dev/null &
    spinner $! "Creating VM instance: $SERVICE_NAME..."
    
    rm -rf "$TMP_DIR"
}

# ============================================
# WAIT FOR READY
# ============================================
wait_ready() {
    section "7/8" "WAITING FOR SERVER INITIALIZATION"
    
    sleep 15
    
    PUBLIC_IP=$(gcloud compute instances describe "$SERVICE_NAME" --zone="$ZONE" --format='get(networkInterfaces[0].accessConfigs[0].natIP)' 2>/dev/null || echo "")
    
    if [ -z "$PUBLIC_IP" ]; then
        error_exit "Could not get public IP."
    fi
    
    success "Public IP: $PUBLIC_IP"
    
    type_text "  [*] Waiting for SSH service to become live..." 0.01
    
    MAX_WAIT=180
    WAITED=0
    
    while [ $WAITED -lt $MAX_WAIT ]; do
        if nc -zv -w 3 "$PUBLIC_IP" "$SSH_PORT" 2>/dev/null; then
            echo ""
            success "SSH service is LIVE on port $SSH_PORT"
            break
        fi
        sleep 10
        WAITED=$((WAITED + 10))
        printf "\r  [*] Waiting... %ss / %ss" "$WAITED" "$MAX_WAIT"
    done
    
    if [ $WAITED -ge $MAX_WAIT ]; then
        warn "Timeout waiting for SSH. Server may still be initializing."
    fi
    
    echo ""
    
    # Verify setup
    gcloud compute ssh "$SERVICE_NAME" --zone="$ZONE" --command="test -f /var/log/vpn-setup-complete.log" \
        --quiet 2>/dev/null && success "Server setup verified" || warn "Setup verification incomplete"
}

# ============================================
# FINAL OUTPUT
# ============================================
show_output() {
    section "8/8" "DEPLOYMENT COMPLETE"
    
    # Get location
    LOCATION=$(curl -s "http://ip-api.com/json/${PUBLIC_IP}" 2>/dev/null || echo "")
    COUNTRY=$(echo "$LOCATION" | grep -o '"country":"[^"]*"' | cut -d'"' -f4 2>/dev/null || echo "N/A")
    CITY=$(echo "$LOCATION" | grep -o '"city":"[^"]*"' | cut -d'"' -f4 2>/dev/null || echo "N/A")
    
    echo ""
    echo -e "${BG_GREEN}${WHITE}${BOLD}                                                     ${RESET}"
    echo -e "${BG_GREEN}${WHITE}${BOLD}     VPN SSH + TLS SERVER DEPLOYED SUCCESSFULLY      ${RESET}"
    echo -e "${BG_GREEN}${WHITE}${BOLD}                                                     ${RESET}"
    echo ""
    echo -e "${CYAN}${BOLD}  =============================================${RESET}"
    echo -e "${CYAN}$
